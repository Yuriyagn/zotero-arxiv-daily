# Copy this file to .env and fill in your own read-only Zotero credentials.
# Never commit the populated .env file.
ZOTERO_ID=
ZOTERO_KEY=

# Used only for Top 20 summary generation through SiliconFlow.
SILICONFLOW_API_KEY=

# QQ Mail SMTP settings. Use an authorization code, not the login password.
SENDER=
RECEIVER=
SENDER_PASSWORD=

# Comma-separated arXiv categories used by scripts/check_sources.py.
ARXIV_CATEGORIES=cs.AI,cs.CV
